[app]

# App title
title = EMI Calculator

# Package name
package.name = emicalculator

# Package domain
package.domain = org.test

# Source code folder
source.dir = .

# Included file types
source.include_exts = py,kv,png,jpg,ttf

# Version
version = 1.0

# Requirements
requirements = python3,kivy==2.2.1,kivymd==1.2.0

# Orientation
orientation = portrait

# Fullscreen
fullscreen = 0

# Android permissions
android.permissions = INTERNET

# Android API versions
android.api = 33
android.minapi = 21

# Accept SDK licenses
android.accept_sdk_license = True

# Presplash color
android.presplash_color = #FFFFFF

# Icon (optional)
# icon.filename = icon.png

# Landscape support
# orientation = all

[buildozer]

# Log level
log_level = 2

# Warn on root
warn_on_root = 1
